---
// Experience snapshot — three numbered bucket cards.
// Translates abstract "skills" into proof of shipping for recruiters.
---

<section class="exp" id="experience" aria-labelledby="exp-title">
  <div class="exp-inner">

    <div class="exp-head">
      <span class="eyebrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="7" width="20" height="14" rx="2"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
        Experience Snapshot
      </span>
      <h2 id="exp-title" class="exp-title">Where I've shipped real work</h2>
    </div>

    <div class="exp-grid">

      <article class="exp-card">
        <span class="exp-num">01</span>
        <h3 class="exp-card__title">Full-Stack Projects</h3>
        <p class="exp-desc">
          Designed and shipped MERN apps end-to-end: schema design, JWT auth,
          REST APIs, responsive UIs, and deployment to Render.
        </p>
        <div class="exp-tags">
          <span>React</span><span>Node</span><span>MongoDB</span>
        </div>
      </article>

      <article class="exp-card">
        <span class="exp-num">02</span>
        <h3 class="exp-card__title">AI Tools &amp; API Integrations</h3>
        <p class="exp-desc">
          Built OpenAI- and Gemini-powered features with graceful fallbacks,
          structured-output parsing, and explicit user confirmation flows.
        </p>
        <div class="exp-tags">
          <span>OpenAI</span><span>Gemini</span><span>Python</span>
        </div>
      </article>

      <article class="exp-card">
        <span class="exp-num">03</span>
        <h3 class="exp-card__title">WordPress / Widget Work</h3>
        <p class="exp-desc">
          Production Elementor widgets backed by Cloudflare workers. Cut API
          calls ~65% via serverless cache; ARIA-labelled, keyboard-friendly.
        </p>
        <div class="exp-tags">
          <span>PHP</span><span>JS</span><span>Cloudflare</span>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  .exp {
    position: relative;
    z-index: 1;
    padding: 56px 0;
  }

  .exp-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .exp-head {
    margin-bottom: 32px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    margin-bottom: 14px;
  }

  .eyebrow svg { width: 14px; height: 14px; color: var(--accent-blue); }

  .exp-title {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.15;
  }

  .exp-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .exp-card {
    position: relative;
    padding: 28px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    transition: border-color .25s ease, transform .25s ease;
  }

  .exp-card::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(135deg, transparent 0%, rgba(167,139,250,0.06) 100%);
    pointer-events: none;
    opacity: 0;
    transition: opacity .3s ease;
  }

  .exp-card:hover {
    border-color: rgba(255, 255, 255, 0.16);
    transform: translateY(-3px);
  }

  .exp-card:hover::after { opacity: 1; }

  [data-theme="light"] .exp-card:hover {
    border-color: rgba(0, 0, 0, 0.14);
  }

  .exp-num {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--accent-blue);
  }

  .exp-card__title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0;
  }

  .exp-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }

  .exp-tags span {
    padding: 4px 9px;
    font-size: 11.5px;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: 6px;
  }

  /* ====== Responsive ====== */
  @media (max-width: 1024px) {
    .exp-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .exp { padding: 44px 0; }
    .exp-inner { padding: 0 20px; }
  }
</style>
