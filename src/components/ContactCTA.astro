---
// Compact contact CTA — one sentence, three obvious buttons.
// Mirrors how recruiters actually want to reach candidates: email or LinkedIn.
---

<section class="cta" id="contact" aria-labelledby="cta-title">
  <div class="cta-inner">
    <div class="cta-card">
      <h2 id="cta-title" class="cta-title">Interested in working together?</h2>
      <p class="cta-sub">
        I'm looking for SWE / SDE roles for Summer 2026 and full-time after graduation.
        The fastest way to reach me is email &mdash; I reply within 24 hours.
      </p>
      <div class="cta-actions">
        <a href="mailto:nicholastheodoruschan@gmail.com" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          Email Me
        </a>
        <a href="https://www.linkedin.com/in/nictc/" class="btn btn-secondary" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 0h-14C2.24 0 0 2.24 0 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5V5c0-2.76-2.24-5-5-5zM8 19H5V8h3v11zM6.5 6.73A1.77 1.77 0 1 1 6.5 3.2a1.77 1.77 0 0 1 0 3.53zM20 19h-3v-5.6c0-3.37-4-3.11-4 0V19h-3V8h3v1.77c1.4-2.59 7-2.78 7 2.48V19z"/>
          </svg>
          LinkedIn
        </a>
        <a href="https://github.com/NicholasTc" class="btn btn-secondary" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.99 5.24.99 11.51c0 4.86 3.15 8.98 7.52 10.43.55.1.75-.24.75-.53v-1.86c-3.06.66-3.71-1.47-3.71-1.47-.5-1.27-1.22-1.61-1.22-1.61-1-.68.07-.67.07-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.57 1.2 3.2.92.1-.71.38-1.2.69-1.48-2.44-.28-5.01-1.22-5.01-5.42 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.91 0 0 .92-.29 3.02 1.12a10.5 10.5 0 0 1 5.5 0c2.1-1.41 3.02-1.12 3.02-1.12.6 1.51.22 2.63.11 2.91.7.77 1.13 1.75 1.13 2.95 0 4.21-2.58 5.13-5.03 5.4.39.34.74 1 .74 2.02v3c0 .29.2.64.76.53A11.02 11.02 0 0 0 23 11.51C23 5.24 18.27.5 12 .5z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    z-index: 1;
    padding: 56px 0 96px;
  }

  .cta-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .cta-card {
    padding: 56px 40px;
    background:
      radial-gradient(ellipse at top left, rgba(96,165,250,0.16) 0%, transparent 55%),
      radial-gradient(ellipse at bottom right, rgba(167,139,250,0.14) 0%, transparent 55%),
      var(--glass);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(14px);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  [data-theme="light"] .cta-card {
    border-color: rgba(0, 0, 0, 0.10);
    background:
      radial-gradient(ellipse at top left, rgba(37,99,235,0.10) 0%, transparent 55%),
      radial-gradient(ellipse at bottom right, rgba(124,58,237,0.10) 0%, transparent 55%),
      var(--glass);
  }

  /* Subtle grid texture overlay */
  .cta-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    pointer-events: none;
  }

  [data-theme="light"] .cta-card::before {
    background-image:
      linear-gradient(rgba(0,0,0,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,0.025) 1px, transparent 1px);
  }

  .cta-title {
    position: relative;
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 12px;
  }

  .cta-sub {
    position: relative;
    color: var(--text-secondary);
    font-size: 16px;
    max-width: 580px;
    margin: 0 auto 28px;
    line-height: 1.65;
  }

  .cta-actions {
    position: relative;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ====== Buttons (scoped to this section) ====== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 13px 22px;
    font-size: 14px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: transform .25s cubic-bezier(.2,.8,.2,1),
                box-shadow .25s ease, background .25s ease,
                color .2s ease, border-color .2s ease;
    cursor: pointer;
    text-decoration: none;
    font-family: var(--font-sans);
  }

  .btn svg { width: 16px; height: 16px; }

  .btn-primary {
    background: var(--gradient-bg);
    color: white;
    box-shadow: 0 8px 24px -6px var(--glow-blue);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -8px var(--glow-purple);
  }

  .btn-secondary {
    background: var(--glass);
    color: var(--text-primary);
    border-color: var(--glass-border);
  }

  .btn-secondary:hover {
    background: var(--surface-hover);
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }

  [data-theme="light"] .btn-secondary:hover {
    border-color: rgba(0, 0, 0, 0.16);
  }

  /* ====== Responsive ====== */
  @media (max-width: 768px) {
    .cta { padding: 44px 0 72px; }
    .cta-inner { padding: 0 20px; }
    .cta-card { padding: 40px 22px; border-radius: var(--radius-lg); }
  }

  @media (max-width: 460px) {
    .cta-actions .btn { width: 100%; }
  }
</style>
