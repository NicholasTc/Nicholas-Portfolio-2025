---
// Recruiter-focused hero. Two columns:
// LEFT  → status pill, name, role, value, CTAs, socials, stack
// RIGHT → small "currently building" code preview (secondary visual)
// Uses CSS fadeIn animations so it reveals smoothly after the intro.
---

<section class="hero" id="home" aria-labelledby="hero-name">
  <div class="hero-inner">
    <div class="hero-grid">

      <!-- ============= LEFT COLUMN ============= -->
      <div class="hero-left">
        <span class="status-pill">
          <span class="status-dot" aria-hidden="true"></span>
          Open to Summer 2026 SWE / SDE roles
        </span>

        <h1 id="hero-name" class="hero-name">
          Nicholas <span class="hero-mid">Theodorus</span>
          <span class="hero-last gradient-text">Chan</span>
        </h1>

        <p class="hero-role">
          Full-Stack Software Engineer
          <span class="role-divider" aria-hidden="true">|</span>
          <span class="role-school">UC San Diego CS</span>
        </p>

        <p class="hero-value">
          I ship clean, testable products end-to-end &mdash; from React UIs to
          Spring&nbsp;Boot APIs. I care about reliability, fast iteration,
          and interfaces that respect the user.
        </p>

        <!-- Primary + secondary CTAs (explicit text, not icon-only) -->
        <div class="cta-row">
          <a href="#projects" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            View Projects
          </a>
          <a href="/resume.pdf" target="_blank" rel="noopener" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download Resume
          </a>
        </div>

        <!-- Quick social row (text labels, not icon-only) -->
        <ul class="social-row" aria-label="Profiles">
          <li>
            <a href="https://github.com/NicholasTc" class="social-chip" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.99 5.24.99 11.51c0 4.86 3.15 8.98 7.52 10.43.55.1.75-.24.75-.53v-1.86c-3.06.66-3.71-1.47-3.71-1.47-.5-1.27-1.22-1.61-1.22-1.61-1-.68.07-.67.07-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.57 1.2 3.2.92.1-.71.38-1.2.69-1.48-2.44-.28-5.01-1.22-5.01-5.42 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.91 0 0 .92-.29 3.02 1.12a10.5 10.5 0 0 1 5.5 0c2.1-1.41 3.02-1.12 3.02-1.12.6 1.51.22 2.63.11 2.91.7.77 1.13 1.75 1.13 2.95 0 4.21-2.58 5.13-5.03 5.4.39.34.74 1 .74 2.02v3c0 .29.2.64.76.53A11.02 11.02 0 0 0 23 11.51C23 5.24 18.27.5 12 .5z"/>
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/nictc/" class="social-chip" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 0h-14C2.24 0 0 2.24 0 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5V5c0-2.76-2.24-5-5-5zM8 19H5V8h3v11zM6.5 6.73A1.77 1.77 0 1 1 6.5 3.2a1.77 1.77 0 0 1 0 3.53zM20 19h-3v-5.6c0-3.37-4-3.11-4 0V19h-3V8h3v1.77c1.4-2.59 7-2.78 7 2.48V19z"/>
              </svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a href="mailto:nicholastheodoruschan@gmail.com" class="social-chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              Email
            </a>
          </li>
        </ul>

        <!-- Tech stack row -->
        <div class="stack-row" aria-label="Primary stack">
          <span class="stack-label">Stack</span>
          <span class="stack-pill">React</span>
          <span class="stack-pill">Node.js</span>
          <span class="stack-pill">Flask</span>
          <span class="stack-pill">Spring Boot</span>
          <span class="stack-pill">MongoDB</span>
        </div>
      </div>

      <!-- ============= RIGHT COLUMN (secondary visual) ============= -->
      <aside class="hero-right" aria-label="Currently building">
        <div class="preview-card">
          <div class="preview-card__chrome">
            <span class="dot dot-r"></span>
            <span class="dot dot-y"></span>
            <span class="dot dot-g"></span>
            <span class="preview-card__file">fitflow / api / auth.ts</span>
          </div>
          <pre class="preview-card__code"><code><span class="cm">// JWT-protected route, user-scoped queries</span>
<span class="kw">export const</span> <span class="fn">getWorkouts</span> = <span class="kw">async</span> (req, res) =&gt; &#123;
  <span class="kw">const</span> userId = req.user.id;
  <span class="kw">const</span> data = <span class="kw">await</span> Workout.<span class="fn">find</span>(&#123; userId &#125;)
    .<span class="fn">sort</span>(&#123; date: -<span class="num">1</span> &#125;)
    .<span class="fn">limit</span>(<span class="num">20</span>);
  res.<span class="fn">json</span>(&#123; ok: <span class="kw">true</span>, data &#125;);
&#125;;</code></pre>
          <div class="preview-card__meta">
            <span class="meta-pill">
              <span class="meta-dot"></span>
              Currently building
            </span>
            <span class="meta-text">FitFlow &middot; MERN &middot; JWT</span>
          </div>
        </div>
      </aside>

    </div>
  </div>
</section>

<style>
  /* ====== Layout ====== */
  /* Generous vertical space so the hero breathes (recruiter eyes
     should land on each piece of info without feeling crammed). */
  .hero {
    position: relative;
    z-index: 1;
    padding: 140px 0 120px;
  }

  .hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
    gap: 72px;
    align-items: center;
  }

  /* ====== Left column ====== */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    width: fit-content;
    opacity: 0;
    animation: heroFadeUp 0.7s ease 0.15s forwards;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
    animation: pulseDot 2s ease-in-out infinite;
  }

  @keyframes pulseDot {
    0%, 100% { box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18); }
    50% { box-shadow: 0 0 0 7px rgba(34, 197, 94, 0.06); }
  }

  .hero-name {
    font-size: clamp(48px, 7vw, 88px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0;
    opacity: 0;
    animation: heroFadeUp 0.85s ease 0.3s forwards;
  }

  /* "Theodorus" sits between in regular weight to keep the name
     scannable and prevent the long full name from feeling heavy. */
  .hero-mid {
    display: inline-block;
    font-weight: 400;
    color: var(--text-secondary);
    font-style: italic;
    font-size: 0.6em;
    vertical-align: 0.18em;
    margin: 0 0.05em 0 0.05em;
    letter-spacing: -0.01em;
  }

  .hero-last {
    /* sits on the same baseline */
    display: inline;
  }

  .gradient-text {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .hero-role {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: clamp(16px, 1.5vw, 19px);
    font-weight: 500;
    color: var(--text-primary);
    margin: 0;
    opacity: 0;
    animation: heroFadeUp 0.85s ease 0.42s forwards;
  }

  .role-divider { color: var(--text-muted); font-weight: 300; }
  .role-school { color: var(--text-secondary); }

  .hero-value {
    font-size: clamp(15px, 1.4vw, 17px);
    color: var(--text-secondary);
    max-width: 560px;
    line-height: 1.75;
    margin: 4px 0 0;
    opacity: 0;
    animation: heroFadeUp 0.85s ease 0.55s forwards;
  }

  /* ====== Buttons ====== */
  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 8px;
    opacity: 0;
    animation: heroFadeUp 0.85s ease 0.68s forwards;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 14px 24px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.005em;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: transform .25s cubic-bezier(.2,.8,.2,1),
                box-shadow .25s ease,
                background .25s ease,
                color .2s ease,
                border-color .2s ease;
    cursor: pointer;
    text-decoration: none;
    font-family: var(--font-sans);
    white-space: nowrap;
  }

  .btn svg { width: 16px; height: 16px; }

  .btn-primary {
    background: var(--gradient-bg);
    color: white;
    box-shadow: 0 8px 24px -6px var(--glow-blue);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -8px var(--glow-purple);
  }

  .btn-secondary {
    background: var(--glass);
    color: var(--text-primary);
    border-color: var(--glass-border);
  }

  .btn-secondary:hover {
    background: var(--surface-hover);
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }

  [data-theme="light"] .btn-secondary:hover {
    border-color: rgba(0, 0, 0, 0.16);
  }

  /* ====== Socials ====== */
  .social-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    opacity: 0;
    animation: heroFadeUp 0.85s ease 0.8s forwards;
  }

  .social-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    transition: color .2s ease, border-color .2s ease, transform .2s ease, background .2s ease;
    text-decoration: none;
  }

  .social-chip svg { width: 14px; height: 14px; }

  .social-chip:hover {
    color: var(--text-primary);
    background: var(--surface-hover);
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-1px);
  }

  [data-theme="light"] .social-chip:hover {
    border-color: rgba(0, 0, 0, 0.16);
  }

  /* ====== Stack row ====== */
  .stack-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
    padding-top: 26px;
    border-top: 1px dashed var(--glass-border);
    opacity: 0;
    animation: heroFadeUp 0.85s ease 0.92s forwards;
  }

  .stack-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-right: 8px;
  }

  .stack-pill {
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-primary);
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
  }

  /* ====== Right: preview card ====== */
  .hero-right {
    display: flex;
    justify-content: flex-end;
    opacity: 0;
    animation: heroFadeUp 0.95s ease 0.6s forwards;
  }

  .preview-card {
    width: 100%;
    max-width: 480px;
    background: linear-gradient(160deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(14px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35), 0 0 60px -20px var(--glow-purple);
    overflow: hidden;
    transform: rotate(-1deg);
    transition: transform .4s cubic-bezier(.2,.8,.2,1);
  }

  [data-theme="light"] .preview-card {
    background: linear-gradient(160deg, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0.65) 100%);
    border-color: rgba(0, 0, 0, 0.10);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08), 0 0 60px -20px rgba(124, 58, 237, 0.22);
  }

  .preview-card:hover { transform: rotate(0deg) translateY(-4px); }

  .preview-card__chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid var(--glass-border);
  }

  [data-theme="light"] .preview-card__chrome {
    background: rgba(0, 0, 0, 0.025);
  }

  .dot { width: 11px; height: 11px; border-radius: 50%; }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c840; }

  .preview-card__file {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .preview-card__code {
    padding: 22px 22px 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    color: #cdd6e4;
    overflow-x: auto;
    white-space: pre;
    margin: 0;
  }

  [data-theme="light"] .preview-card__code {
    color: #1f2937;
  }

  .preview-card__code .cm { color: var(--text-muted); font-style: italic; }
  .preview-card__code .kw { color: var(--accent-purple); }
  .preview-card__code .fn { color: var(--accent-blue); }
  .preview-card__code .num { color: var(--accent-cyan); }

  .preview-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border-top: 1px solid var(--glass-border);
    background: rgba(255,255,255,0.02);
  }

  [data-theme="light"] .preview-card__meta {
    background: rgba(0, 0, 0, 0.02);
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 11px;
    font-size: 11.5px;
    font-weight: 500;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--accent-green);
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 999px;
  }

  .meta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-green);
    box-shadow: 0 0 8px var(--accent-green);
  }

  .meta-text {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
  }

  /* ====== Reveal animation ====== */
  @keyframes heroFadeUp {
    0%   { opacity: 0; transform: translateY(14px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* ====== Responsive ====== */
  @media (max-width: 1024px) {
    .hero { padding: 110px 0 90px; }
    .hero-grid { grid-template-columns: 1fr; gap: 56px; }
    .hero-right { justify-content: flex-start; }
    .preview-card { max-width: 540px; }
  }

  @media (max-width: 768px) {
    .hero { padding: 88px 0 72px; }
    .hero-inner { padding: 0 20px; }
    .hero-name { font-size: clamp(40px, 11vw, 60px); }
    .hero-mid { font-size: 0.55em; }
    .preview-card { transform: none; }
    .cta-row .btn { flex: 1 1 auto; }
  }

  @media (max-width: 460px) {
    .cta-row { flex-direction: column; }
    .cta-row .btn { width: 100%; }
  }

  /* Reduced motion: skip the entrance animation, no transforms */
  @media (prefers-reduced-motion: reduce) {
    .status-pill,
    .hero-name,
    .hero-role,
    .hero-value,
    .cta-row,
    .social-row,
    .stack-row,
    .hero-right {
      animation: none;
      opacity: 1;
    }
  }
</style>
