---
// Top-3 featured projects on the homepage.
// Why curated:
//   The homepage should be a quick HIGHLIGHT REEL, not a duplicate of /projects.
//   FitFlow is the largest/featured card because it shows full-stack range.
//   Each card has explicit text buttons (Case Study / GitHub / Live Demo)
//   so recruiters never have to guess what an arrow icon means.
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="section-inner">

    <div class="section-head">
      <span class="eyebrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
        Featured Work
      </span>
      <h2 id="projects-title" class="section-title">Top 3 projects, hand-picked</h2>
      <p class="section-desc">
        A quick look at my strongest work.
        <a href="/projects" class="inline-link">See all projects &rarr;</a>
      </p>
    </div>

    <div class="projects-grid">

      <!-- ===== Featured: FitFlow (full width, image+body split) ===== -->
      <article class="project-card project-card--featured">
        <div class="project-media">
          <img src="/FitFlowScreenshot.png" alt="FitFlow dashboard preview" loading="lazy" />
          <span class="project-badge">Featured</span>
        </div>
        <div class="project-body">
          <div class="project-meta">
            <span class="project-cat">Full-Stack Web App</span>
            <span class="project-year">2026</span>
          </div>
          <h3 class="project-title">FitFlow &mdash; Fitness &amp; Nutrition Platform</h3>
          <p class="project-summary">
            MERN + JWT app with weekly workout planning, unified nutrition logging,
            and an AI meal helper. Ships with secure user-scoped routes and a clean,
            calm dashboard.
          </p>
          <ul class="project-tags" aria-label="Tech stack">
            <li>React</li><li>Node.js</li><li>Express</li><li>MongoDB</li><li>JWT</li><li>Gemini API</li>
          </ul>
          <div class="project-actions">
            <a href="/projects" class="btn btn-primary btn-sm">Case Study</a>
            <a href="https://github.com/NicholasTc/fitness-tracker.git" class="btn btn-ghost btn-sm" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.99 5.24.99 11.51c0 4.86 3.15 8.98 7.52 10.43.55.1.75-.24.75-.53v-1.86c-3.06.66-3.71-1.47-3.71-1.47-.5-1.27-1.22-1.61-1.22-1.61-1-.68.07-.67.07-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.57 1.2 3.2.92.1-.71.38-1.2.69-1.48-2.44-.28-5.01-1.22-5.01-5.42 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.91 0 0 .92-.29 3.02 1.12a10.5 10.5 0 0 1 5.5 0c2.1-1.41 3.02-1.12 3.02-1.12.6 1.51.22 2.63.11 2.91.7.77 1.13 1.75 1.13 2.95 0 4.21-2.58 5.13-5.03 5.4.39.34.74 1 .74 2.02v3c0 .29.2.64.76.53A11.02 11.02 0 0 0 23 11.51C23 5.24 18.27.5 12 .5z"/>
              </svg>
              GitHub
            </a>
            <a href="https://fitness-tracker-islq.onrender.com" class="btn btn-ghost btn-sm" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              Live Demo
            </a>
          </div>
        </div>
      </article>

      <!-- ===== Secondary: ResumeAI ===== -->
      <article class="project-card">
        <div class="project-media project-media--sm">
          <img src="/ResumeAITool.png" alt="ResumeAI Tool preview" loading="lazy" />
        </div>
        <div class="project-body">
          <div class="project-meta">
            <span class="project-cat">AI / API Integration</span>
            <span class="project-year">2025</span>
          </div>
          <h3 class="project-title">ResumeAI Tool</h3>
          <p class="project-summary">
            Resume parser using OpenAI with 85% improved extraction accuracy
            across PDF, Word, and plain-text formats.
          </p>
          <ul class="project-tags" aria-label="Tech stack">
            <li>Python</li><li>OpenAI</li><li>Flask</li>
          </ul>
          <div class="project-actions">
            <a href="/projects" class="btn btn-primary btn-sm">Case Study</a>
            <a href="#" class="btn btn-ghost btn-sm">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.99 5.24.99 11.51c0 4.86 3.15 8.98 7.52 10.43.55.1.75-.24.75-.53v-1.86c-3.06.66-3.71-1.47-3.71-1.47-.5-1.27-1.22-1.61-1.22-1.61-1-.68.07-.67.07-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.57 1.2 3.2.92.1-.71.38-1.2.69-1.48-2.44-.28-5.01-1.22-5.01-5.42 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.91 0 0 .92-.29 3.02 1.12a10.5 10.5 0 0 1 5.5 0c2.1-1.41 3.02-1.12 3.02-1.12.6 1.51.22 2.63.11 2.91.7.77 1.13 1.75 1.13 2.95 0 4.21-2.58 5.13-5.03 5.4.39.34.74 1 .74 2.02v3c0 .29.2.64.76.53A11.02 11.02 0 0 0 23 11.51C23 5.24 18.27.5 12 .5z"/>
              </svg>
              GitHub
            </a>
          </div>
        </div>
      </article>

      <!-- ===== Secondary: Pollen Atlas ===== -->
      <article class="project-card">
        <div class="project-media project-media--sm">
          <img src="/PollenAtlas.png" alt="Pollen Atlas widget preview" loading="lazy" />
        </div>
        <div class="project-body">
          <div class="project-meta">
            <span class="project-cat">WordPress Widget</span>
            <span class="project-year">2025</span>
          </div>
          <h3 class="project-title">Pollen Atlas Widget</h3>
          <p class="project-summary">
            Elementor widget that combines Google Pollen + Air Quality APIs with
            accessible charts. Serverless cache cut API calls ~65%.
          </p>
          <ul class="project-tags" aria-label="Tech stack">
            <li>PHP</li><li>JavaScript</li><li>Cloudflare</li>
          </ul>
          <div class="project-actions">
            <a href="/projects" class="btn btn-primary btn-sm">Case Study</a>
            <a href="#" class="btn btn-ghost btn-sm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              Live Demo
            </a>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    z-index: 1;
    padding: 80px 0;
  }

  .section-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .section-head {
    margin-bottom: 40px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .eyebrow svg { width: 14px; height: 14px; color: var(--accent-blue); }

  .section-title {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.15;
  }

  .section-desc {
    margin-top: 12px;
    color: var(--text-secondary);
    font-size: 16px;
    max-width: 640px;
  }

  .inline-link {
    color: var(--accent-blue);
    font-weight: 500;
    border-bottom: 1px dashed transparent;
    transition: border-color .2s ease, color .2s ease;
  }

  .inline-link:hover {
    color: var(--accent-purple);
    border-bottom-color: currentColor;
  }

  /* ====== Grid ====== */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  /* ====== Card ====== */
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    backdrop-filter: blur(12px);
    transition: border-color .25s ease, transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .project-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgba(96,165,250,0.4) 0%, rgba(167,139,250,0.2) 50%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    opacity: 0;
    transition: opacity .3s ease;
    pointer-events: none;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }

  .project-card:hover::before { opacity: 1; }

  [data-theme="light"] .project-card:hover {
    border-color: rgba(0, 0, 0, 0.14);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  /* ====== Featured layout ====== */
  .project-card--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: stretch;
  }

  .project-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-tertiary);
  }

  .project-card--featured .project-media {
    aspect-ratio: auto;
    min-height: 100%;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform .6s cubic-bezier(.2,.8,.2,1);
  }

  .project-card:hover .project-media img { transform: scale(1.04); }

  .project-media--sm { aspect-ratio: 16 / 10; }

  .project-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 5px 11px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: white;
    background: var(--gradient-bg);
    border-radius: 999px;
    box-shadow: 0 4px 14px var(--glow-blue);
  }

  /* ====== Body ====== */
  .project-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .project-card--featured .project-body { padding: 36px; gap: 14px; }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .project-cat {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-blue);
  }

  .project-year {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
  }

  .project-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    line-height: 1.25;
    margin: 0;
  }

  .project-card--featured .project-title { font-size: 26px; }

  .project-summary {
    font-size: 14.5px;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .project-tags li {
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 500;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: 6px;
  }

  .project-actions {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  /* ====== Buttons ====== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: transform .25s cubic-bezier(.2,.8,.2,1),
                box-shadow .25s ease, background .25s ease,
                color .2s ease, border-color .2s ease;
    cursor: pointer;
    text-decoration: none;
    font-family: var(--font-sans);
  }

  .btn svg { width: 14px; height: 14px; }

  .btn-primary {
    background: var(--gradient-bg);
    color: white;
    box-shadow: 0 6px 20px -6px var(--glow-blue);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px -8px var(--glow-purple);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
    border-color: var(--glass-border);
  }

  .btn-ghost:hover {
    color: var(--text-primary);
    background: var(--surface-hover);
    border-color: rgba(255, 255, 255, 0.18);
  }

  [data-theme="light"] .btn-ghost:hover {
    border-color: rgba(0, 0, 0, 0.16);
  }

  /* ====== Responsive ====== */
  @media (max-width: 1024px) {
    .project-card--featured { grid-template-columns: 1fr; }
    .project-card--featured .project-media {
      aspect-ratio: 16 / 8;
      min-height: 0;
    }
    .project-card--featured .project-body { padding: 28px; }
  }

  @media (max-width: 768px) {
    .section { padding: 60px 0; }
    .section-inner { padding: 0 20px; }
    .projects-grid { grid-template-columns: 1fr; }
    .project-card--featured .project-title { font-size: 22px; }
  }
</style>
