---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import AboutSection from '../components/AboutSection.astro';
import SkillsSnapshot from '../components/SkillsSnapshot.astro';
import ExperienceSnapshot from '../components/ExperienceSnapshot.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Nicholas Theodorus Chan — Portfolio">
  <!-- Background Effects -->
  <div class="bg-grid"></div>
  <div class="bg-gradient-orbs">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
        </div>

  <!-- Navigation -->
  <Navigation />

  <!-- Hero (recruiter-focused, "Nicholas Theodorus Chan", more breathing room) -->
  <Hero />

  <!-- Top 3 featured projects (FitFlow featured) -->
  <ProjectsGrid />

  <!-- About Me — sits between Featured Projects and Skills (per spec) -->
  <AboutSection />

  <!-- Skills snapshot (compact 4-card grid grouped by domain) -->
  <SkillsSnapshot />

  <!-- Experience snapshot (3 numbered bucket cards) -->
  <ExperienceSnapshot />

  <!-- Contact CTA (compact, recruiter-friendly) -->
  <ContactCTA />

  <!-- Footer -->
  <Footer />
</BaseLayout>

