                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- Portfolio Website -->
        <article class="project-card" data-category="frontend">
          <div class="project-image placeholder">
            <div class="placeholder-icon" aria-hidden="true">
              <ion-icon name="color-palette-outline"></ion-icon>
            </div>
            <div class="project-image-overlay"></div>
          </div>
          <div class="project-content">
            <div class="project-tags">
              <span class="project-tag frontend">Frontend</span>
              <span class="project-tag">Astro</span>
            </div>
            <h3 class="project-title">
              Portfolio 2025
            </h3>
            <p class="project-desc">This very website! Built with Astro for optimal performance, featuring glass-morphism design, matrix rain animations, and silky-smooth interactions.</p>
            <div class="project-stack">
              <span class="stack-item">Astro</span>
              <span class="stack-item">TypeScript</span>
              <span class="stack-item">CSS</span>
            </div>
            <div class="project-meta">
              <span class="meta-item">
                <ion-icon class="meta-icon" name="calendar-outline" aria-hidden="true"></ion-icon> 2025
              </span>
              <div class="project-links">
