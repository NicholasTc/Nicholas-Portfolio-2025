</style>

<script>
  // Filter functionality
  const filterTabs = document.querySelectorAll('.filter-tab');
  const projectCards = document.querySelectorAll('.project-card');

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update active tab
      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const filter = (tab as HTMLElement).dataset.filter;

      // Filter projects
      projectCards.forEach(card => {
        const category = (card as HTMLElement).dataset.category;
        
        if (filter === 'all' || category === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // ── Image modal ── //
  const backdrop = document.getElementById('imgModalBackdrop') as HTMLElement;
  const modalImg = document.getElementById('imgModalImg') as HTMLImageElement;
  const closeBtn = document.getElementById('imgModalClose') as HTMLElement;

  function openModal(src: string, alt: string) {
    modalImg.src = src;
    modalImg.alt = alt;
    backdrop.classList.add('open');
    backdrop.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    backdrop.classList.remove('open');
    backdrop.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Inject "View Full Image" button into every image container that has an <img>
  document.querySelectorAll('.project-image').forEach(container => {
    const img = container.querySelector('img');
    if (!img) return;

    const btn = document.createElement('button');
    btn.className = 'view-image-btn';
    btn.textContent = 'View Full Image';
    btn.setAttribute('aria-label', 'View full image');
    container.appendChild(btn);

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      openModal(img.src, img.alt);
    });
  });

  closeBtn.addEventListener('click', closeModal);

  backdrop.addEventListener('click', (e) => {
    if (e.target === backdrop) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

