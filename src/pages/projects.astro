---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Projects — Nicholas Chan">
  <!-- Background Effects -->
  <div class="bg-grid"></div>
  <div class="bg-gradient-orbs">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
  </div>

  <Navigation />

  <!-- Page Header -->
  <header class="page-header">
    <div class="page-header-inner">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>→</span>
        <span>Projects</span>
      </div>
      <h1 class="page-title">Crafted with <span class="gradient-text">precision.</span></h1>
      <p class="page-subtitle">A curated collection of projects showcasing my journey through full-stack development, AI integration, and thoughtful UX design.</p>
      <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">All Projects</button>
        <button class="filter-tab" data-filter="fullstack">Full-Stack</button>
        <button class="filter-tab" data-filter="ai">AI / ML</button>
        <button class="filter-tab" data-filter="frontend">Frontend</button>
        <button class="filter-tab" data-filter="wordpress">WordPress</button>
      </div>
    </div>
  </header>

  <!-- Projects Grid -->
  <section class="projects-section">
    <div class="projects-inner">
      <div class="projects-grid">
        <!-- Featured: FitFlow -->
        <article class="project-card featured" data-category="fullstack">
          <div class="project-image">
            <img src="/FitFlowScreenshot.png" alt="FitFlow dashboard with workout and nutrition modules" />
            <div class="project-image-overlay"></div>
          </div>
          <div class="project-content">
            <div class="project-tags">
              <span class="project-tag">Full-Stack</span>
              <span class="project-tag backend">MERN + JWT</span>
            </div>
            <h3 class="project-title">
              FitFlow — Fitness Tracker
            </h3>
            <p class="project-desc">A full-stack fitness platform that unifies workout planning, calendar scheduling, nutrition logging, and progress tracking with JWT-protected user data. Nutrition includes quick-log + meal-builder modes, grouped daily logs, USDA/Open Food Facts ingredient search, and a Gemini-powered meal draft helper with graceful fallback parsing.</p>
            <div class="project-stack">
              <span class="stack-item">React (Vite)</span>
              <span class="stack-item">Node.js</span>
              <span class="stack-item">Express</span>
              <span class="stack-item">MongoDB</span>
              <span class="stack-item">JWT</span>
              <span class="stack-item">Gemini API</span>
            </div>
            <div class="project-meta">
              <span class="meta-item">
                <ion-icon class="meta-icon" name="calendar-outline" aria-hidden="true"></ion-icon> 2026
              </span>
              <span class="meta-item">
                <ion-icon class="meta-icon" name="time-outline" aria-hidden="true"></ion-icon> 3 months
              </span>
              <div class="project-links">
                <a href="https://github.com/NicholasTc/fitness-tracker.git" target="_blank" rel="noopener noreferrer" class="project-link" title="GitHub">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
                <a href="https://fitness-tracker-islq.onrender.com" target="_blank" rel="noopener noreferrer" class="project-link" title="Live Demo">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- FitAI — Readiness Intelligence -->
        <article class="project-card tall" data-category="ai">
          <div class="project-image">
            <img src="/FitAI/fitai-dashboard.png" alt="FitAI readiness dashboard showing a score of 70 and Maintain Day recommendation" />
            <div class="project-image-overlay"></div>
          </div>
          <div class="project-content">
            <div class="project-tags">
              <span class="project-tag ai">AI / ML</span>
              <span class="project-tag backend">Next.js</span>
            </div>
            <h3 class="project-title">
              FitAI — Readiness Intelligence
            </h3>
            <p class="project-desc">Pulls biometric data from the newly released Fitbit Air (May 2026) via the Google Fit API, then computes a personalised readiness score using a rolling statistical model that learns from your own baselines — so every metric is compared to <em>you</em>, not a population average. The score improves as more data is collected. Integrated with Gemini AI to explain what each signal means in plain language and generate a daily strategy (Explain / Plan Today / Set up Tomorrow) tailored to your exact readiness level and limiting factors.</p>
            <div class="project-stack">
              <span class="stack-item">Next.js</span>
              <span class="stack-item">SQL</span>
              <span class="stack-item">Fitbit Air API</span>
              <span class="stack-item">Google Fit API</span>
              <span class="stack-item">Gemini API</span>
              <span class="stack-item">Railway</span>
            </div>
            <div class="project-meta">
              <span class="meta-item">
                <ion-icon class="meta-icon" name="calendar-outline" aria-hidden="true"></ion-icon> 2026
              </span>
              <span class="meta-item">
                <ion-icon class="meta-icon" name="time-outline" aria-hidden="true"></ion-icon> In progress
              </span>
              <div class="project-links">
                <a href="https://github.com/NicholasTc/FitAI.git" target="_blank" rel="noopener noreferrer" class="project-link" title="GitHub">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
                <a href="https://fitai-production-799a.up.railway.app/dashboard" target="_blank" rel="noopener noreferrer" class="project-link" title="Live Demo">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- ResumeAI Tool -->
        <article class="project-card tall" data-category="ai">
          <div class="project-image">
            <img src="/ResumeAITool.png" alt="ResumeAI Tool interface" />
            <div class="project-image-overlay"></div>
          </div>
          <div class="project-content">
            <div class="project-tags">
              <span class="project-tag ai">AI / ML</span>
              <span class="project-tag backend">Python</span>
            </div>
            <h3 class="project-title">
              ResumeAI Tool
            </h3>
            <p class="project-desc">AI-powered resume parsing leveraging OpenAI for intelligent data extraction, achieving 85% improved accuracy across multiple document formats including PDF, DOCX, and plain text.</p>
            <div class="project-stack">
              <span class="stack-item">OpenAI</span>
              <span class="stack-item">Python</span>
              <span class="stack-item">Flask</span>
              <span class="stack-item">PyPDF2</span>
            </div>
            <div class="project-meta">
              <span class="meta-item">
                <ion-icon class="meta-icon" name="calendar-outline" aria-hidden="true"></ion-icon> 2024
              </span>
              <div class="project-links">
                <a href="#" class="project-link" title="GitHub">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- Pollen Atlas Widget -->
        <article class="project-card" data-category="wordpress">
          <div class="project-image">
            <img src="/PollenAtlas.png" alt="Pollen Atlas Widget dashboard" />
            <div class="project-image-overlay"></div>
          </div>
          <div class="project-content">
            <div class="project-tags">
              <span class="project-tag wordpress">WordPress</span>
              <span class="project-tag">API Integration</span>
            </div>
            <h3 class="project-title">
              Pollen Atlas Widget
            </h3>
            <p class="project-desc">Elementor widget combining Google Pollen & Air Quality APIs with accessible, interactive Chart.js visualizations.</p>
            <div class="project-stack">
              <span class="stack-item">PHP</span>
              <span class="stack-item">JavaScript</span>
              <span class="stack-item">Chart.js</span>
            </div>
            <div class="project-meta">
              <span class="meta-item">
                <ion-icon class="meta-icon" name="calendar-outline" aria-hidden="true"></ion-icon> 2025
              </span>
              <div class="project-links">
                <a href="#" class="project-link" title="Live Demo">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- ProductivityHelper -->
        <article class="project-card" data-category="frontend">
          <div class="project-image">
            <img src="/ProductivityHelper.png" alt="ProductivityHelper interface" />
            <div class="project-image-overlay"></div>
          </div>
          <div class="project-content">
            <div class="project-tags">
              <span class="project-tag">Productivity</span>
              <span class="project-tag frontend">React</span>
            </div>
            <h3 class="project-title">
              ProductivityHelper
            </h3>
            <p class="project-desc">Task management application featuring focus mode, weekly planning, and productivity analytics with a clean, distraction-free interface.</p>
            <div class="project-stack">
              <span class="stack-item">React</span>
              <span class="stack-item">Node.js</span>
              <span class="stack-item">SQLite</span>
            </div>
            <div class="project-meta">
              <span class="meta-item">
                <ion-icon class="meta-icon" name="calendar-outline" aria-hidden="true"></ion-icon> 2023
              </span>
              <div class="project-links">
                <a href="#" class="project-link" title="GitHub">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
                <a href="#" class="project-link" title="Live Demo">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- TaskPilot -->
        <article class="project-card" data-category="fullstack">
          <div class="project-image">
            <img src="/TaskPilot/taskpilot-dashboard.png" alt="TaskPilot automated scheduler interface" />
            <div class="project-image-overlay"></div>
          </div>
          <div class="project-content">
            <div class="project-tags">
              <span class="project-tag">Full-Stack</span>
              <span class="project-tag frontend">Next.js</span>
            </div>
            <h3 class="project-title">
              TaskPilot
            </h3>
            <p class="project-desc">An automated scheduler that cuts planning time and cognitive load so you can stay in execution mode instead of constantly re-planning your day.</p>
            <div class="project-stack">
              <span class="stack-item">Next.js</span>
              <span class="stack-item">React</span>
              <span class="stack-item">MongoDB</span>
            </div>
            <div class="project-meta">
